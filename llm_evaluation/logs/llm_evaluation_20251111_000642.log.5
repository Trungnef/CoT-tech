f(0) = 0³ − 3*0² + 4 = 4;
f(2) = 2³ − 3*(2)^2 + 4 = 8 − 12 + 4 = 0;
f(3) = 3³ − 3*(3)^2 + 4 = 27 − 27 + 4 = 4.
