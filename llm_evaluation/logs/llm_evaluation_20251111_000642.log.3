so_cau_tat_ca = 20
ty_le_phan_tram = (so_cau_dung / so_cau_tat_ca) * 100
print(f"Tỷ lệ phần trăm theo công thức: {ty_le_phan_tram}%")

# Phương pháp 2: Dùng tỉ số
tiso = 12 / 20
ty_le_phan_tram_2 = tiso * 100
print(f"Tỷ lệ phần trăm theo tỉ số: {ty_le_phan_tram_2}%")

# Phương pháp 3: Biểu diễn bằng phần trăm trực tiếp
phan_tram_moi_cau = 100 / 20
so_phan_tram = phan_tram_moi_cau * 12
print(f"Tỷ lệ phần trăm trực tiếp: {so_phan_tram}%")
