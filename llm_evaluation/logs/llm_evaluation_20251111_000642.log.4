```python
# Calculate the sum of the fractions 2/2 and 4/4
from fractions import Fraction

# Convert each fraction to its simplified form and then add
frac1 = Fraction(2, 2)
frac2 = Fraction(4, 4)

result = frac1 + frac2
print(result)
