```python
def tinh_tien_can_tra(gia_moi_quyen, so_luong, phan_giam):
    """
    Hàm tính số tiền cần trả sau khi áp dụng giảm giá cho đơn hàng.
    
    Parameters:
    gia_moi_quyen (float): Giá của mỗi quyển vở.
    so_luong (int): Số lượng quyển vở được mua.
    phan_giam (float): Tỷ lệ phần trăm giảm giá (vd: 0.20 cho 20%).
    
    Returns:
    float: Số tiền cần trả sau khi áp dụng giảm giá.
    """
    # Tính tổng giá ban đầu trước khi giảm giá
    tong_gia = so_luong * gia_moi_quyen
    
    # Tính phần giảm giá
    phan_giam_gia = tong_gia * phan_giam
    
    # Tính số tiền cần trả sau khi giảm giá
    so_tien_nen_tra = tong_gia - phan_giam_gia
    
    return so_tien_nen_tra

# Gọi hàm với các tham số cụ thể
gia_moi_quyen = 7000
so_luong = 6
phan_giam = 0.20

kết_quả = tinh_tien_can_tra(gia_moi_quyen, so_luong, phan_giam)
kết_quả
```














