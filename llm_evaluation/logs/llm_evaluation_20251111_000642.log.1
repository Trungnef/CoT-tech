```python
# Giải bài toán bằng phương pháp ReAct

# Suy nghĩ 1: Bài toán yêu cầu tìm hai số khi biết tổng và hiệu của chúng.
# Hành động 1: Sử dụng công thức tính số lớn và số bé dựa trên tổng và hiệu.
# Công thức: số lớn = (tổng + hiệu) / 2, số bé = (tổng - hiệu) / 2.

# Kết quả 1: Thay số vào công thức
so_lon = (44 + 24) // 2
so_be = (44 - 24) // 2

# Suy nghĩ 2: Kiểm tra lại kết quả
# Hành động 2: Xác nhận tổng và hiệu của kết quả
tong = so_lon + so_be
hieu = so_lon - so_be

# Kết quả 2: Kết quả kiểm tra
print("Tổng:", tong)
print("Hiệu:", hieu)

# Đáp án cuối cùng: In ra kết quả
print("Số lớn là", so_lon, "và số bé là", so_be)
```

