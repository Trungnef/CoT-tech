```python
# Code kiểm tra tính chất
def check_divisibility_by_9(number):
    sum_digits = sum(int(digit) for digit in str(number))
    return number % 9 == 0 and sum_digits % 9 == 0

# Test với các số
test_numbers = [18, 99, 189, 108, 117, 126, 135]
results = {num: check_divisibility_by_9(num) for num in test_numbers}
print(results)
```

