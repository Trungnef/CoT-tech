```python
# Tính toán theo phương pháp đại số
# Giải hệ phương trình:
# x + y = 48
# x - y = 28

# Cộng hai phương trình lại:
# (x + y) + (x - y) = 48 + 28 => 2x = 76 => x = 38
x = 76 // 2

# Thay x vào phương trình x + y = 48 để tìm y
y = 48 - x

x, y
