# Giải bài toán bằng phương pháp lập hệ phương trình

# Gọi số lớn là L, số nhỏ là S
# Theo đề bài, ta có:
# L + S = 94
# L - S = 12

# Bước 1: Cộng hai phương trình lại để tìm L
total_sum = 94
difference = 12
sum_equation = total_sum + difference  # 94 + 12 = 106
L = sum_equation // 2  # 106 / 2 = 53

# Bước 2: Tính số nhỏ S từ tổng hoặc hiệu
S = total_sum - L  # 94 - 53 = 41

# Kiểm tra kết quả
assert L + S == total_sum, "Tổng không đúng"
assert L - S == difference, "Hiệu không đúng"

# Kết quả cuối cùng
print(f"Số lớn là {L} và số bé là {S}")
